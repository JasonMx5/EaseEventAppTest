@page "/event/{Id:int}"

@using EventEaseApp.Models
@using EventEaseApp.Services

@inject EventRegistrationState RegistrationState

<PageTitle>Event Details</PageTitle>

@if (Event is null)
{
    <p>Event not found.</p>
}
else
{
    <h1>@Event.Name</h1>

    <div class="details-card">
        <p><strong>Date:</strong> @Event.Date.ToString("MMMM dd, yyyy")</p>
        <p><strong>Location:</strong> @Event.Location</p>
        <p><strong>Description:</strong> @Event.Description</p>
    </div>

    <div class="details-actions">
        <NavLink class="btn btn-primary" href="">Back to Events</NavLink>
        <NavLink class="btn btn-secondary" href="@($"register/{Event.Id}")">Register</NavLink>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EventItem? Event => EventCatalog.GetEventById(Id);

    protected override void OnParametersSet()
    {
        RegistrationState.SelectEvent(Id);
    }
}

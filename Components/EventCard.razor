@using EventEaseApp.Models

<div class="event-card">
    <div class="event-card__header">
        <span class="event-card__badge">Upcoming Event</span>
    </div>

    <h3 class="event-card__title">@Event.Name</h3>

    <dl class="event-card__details">
        <div class="event-card__row">
            <dt>Date</dt>
            <dd>@Event.Date.ToString("MMMM dd, yyyy")</dd>
        </div>
        <div class="event-card__row">
            <dt>Location</dt>
            <dd>@Event.Location</dd>
        </div>
    </dl>

    <div class="event-card__actions">
        <NavLink class="btn btn-primary" href="@($"event/{Event.Id}")">View Details</NavLink>
        <NavLink class="btn btn-secondary" href="@($"register/{Event.Id}")">Register</NavLink>
    </div>
</div>

@code {
    [Parameter]
    public EventItem Event { get; set; } = new();
}
